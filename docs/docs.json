{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Foglamp",
  "description": "The missing observability layer for AI agents. Costs, latency, tokens, distributed traces, evals, and alerts for every model call - in two lines.",
  "colors": {
    "primary": "#171717",
    "light": "#FFFFFF",
    "dark": "#171717"
  },
  "favicon": {
    "light": "images/icon.png",
    "dark": "images/icon.png"
  },
  "logo": {
    "light": "/docs/images/Frame@2x(2).png",
    "dark": "/docs/images/Frame@2x(1).png"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "introduction",
              "quickstart",
              "ai-instrument",
              "troubleshooting"
            ]
          },
          {
            "group": "Core concepts",
            "pages": ["concepts/data-model"]
          },
          {
            "group": "SDK",
            "pages": [
              "sdk/overview",
              "sdk/configuration",
              "sdk/runtimes",
              "sdk/wrap",
              "sdk/hud"
            ]
          }
        ]
      },
      {
        "tab": "Dashboard",
        "groups": [
          {
            "group": "Explore",
            "pages": [
              "dashboard/overview",
              "dashboard/traces",
              "dashboard/workflows",
              "dashboard/agents",
              "dashboard/sessions"
            ]
          },
          {
            "group": "Operate",
            "pages": [
              "dashboard/alerts",
              "dashboard/evals",
              "dashboard/cost",
              "dashboard/account"
            ]
          }
        ]
      },
      {
        "tab": "Self-hosting",
        "groups": [
          {
            "group": "Self-hosting",
            "pages": ["self-hosting/overview", "self-hosting/configuration"]
          }
        ]
      },
      {
        "tab": "Changelog",
        "pages": ["changelog"]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "API reference",
            "pages": ["api-reference/introduction"]
          },
          {
            "group": "Ingest",
            "openapi": "api-reference/openapi.json",
            "pages": ["POST /ingest", "GET /health"]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [],
    "primary": {
      "type": "github",
      "href": "https://github.com/foglamp-labs/foglamp"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/foglamp-labs/foglamp"
    }
  },
  "icons": {
    "library": "tabler"
  },
  "background": {
    "color": {
      "light": "#FAFAFA",
      "dark": "#0F0F0F"
    }
  },
  "fonts": {
    "family": "Inter"
  },
  "thumbnails": {
    "fonts": {
      "family": "Inter"
    }
  },
  "contextual": {
    "options": ["copy", "assistant", "view", "chatgpt", "claude", "cursor"],
    "display": "header"
  },
  "seo": {
    "indexing": "navigable"
  },
  "integrations": {
